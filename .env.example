# AI Inference Platform — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.
# All values here MUST remain empty. No secrets in this file.

# ── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
# Response cache TTL in seconds (default: 3600)
LITELLM_CACHE_TTL=

# ── LLM provider API keys ────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# ── Langfuse (obs profile) ───────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Langfuse server + worker — obs profile only
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
SALT=
# Langfuse DB connection (separate from litellm DB)
# Format: postgresql://user:password@host:port/langfuse
LANGFUSE_DATABASE_URL=

# ── OTel Collector + Phoenix Arize (obs profile) ─────────────────────────────
# LiteLLM exports spans to the OTel Collector (not directly to Phoenix).
# The Collector enriches spans with gateway.request_id and forwards to Phoenix.
# Set to: http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
# Phoenix DB connection
# Format: postgresql://user:password@host:port/phoenix
PHOENIX_SQL_DATABASE_URL=

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# ── HashiCorp Vault ──────────────────────────────────────────────────────────
VAULT_ROOT_TOKEN=
VAULT_ADDR=

# ── OPA ──────────────────────────────────────────────────────────────────────
OPA_API_KEY=

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ── Kong ─────────────────────────────────────────────────────────────────────
# Smoke-test consumer API key — provisioned into Kong DB via seed-kong.sh.
# Use any non-empty string for local dev (e.g. a random UUID).
# Send as: Authorization: <raw-key>  (no "Bearer " prefix)
# Kong PG connection reuses POSTGRES_USER / POSTGRES_PASSWORD above.
SMOKE_API_KEY=

# ── Kong request size limit ───────────────────────────────────────────────────
# Maximum request body size in MB. Requests exceeding this return 413. Default: 10.
REQUEST_SIZE_LIMIT_MB=

# ── LiteLLM database connection ───────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ── Portal backend ────────────────────────────────────────────────────────────
# LITELLM_MASTER_KEY is shared with the litellm service (defined above).
# No additional secrets required for portal-backend.

# ── Batch worker (017-async-batch-inference) ──────────────────────────────────
# PostgreSQL connection for the batch database (7th DB, schema-isolated from litellm).
# Format: postgresql://user:password@host:port/batch
BATCH_DATABASE_URL=
# Redis connection for the RQ job queue (redis-queue instance on port 6380).
# Format: redis://redis-queue:6380
REDIS_QUEUE_URL=
# Maximum simultaneous in-flight LiteLLM calls per batch job. Default: 4.
MAX_CONCURRENT=
# Filesystem path where JSONL result files are written. Mounted as a Docker volume.
RESULTS_DIR=
# OTel service name tag for batch-worker spans (distinct from kong-gateway).
OTEL_SERVICE_NAME=
